.python/

# Local config
.env

# Runtime data.  Everything the app produces lives in the data directory
# (DLC_DATA_DIR), which is outside the repo by default — these entries
# cover the case where someone points it at the project folder itself.
data/
videos/
dlc/
sample_data/
*.db
*.db-wal
*.db-shm
settings.json
job_history.jsonl
*.log

# Offline install media (see run.bat)
wheels/

# Per-machine calibrations.  cam1_calibration.yaml is the shipped
# example; a rig's own calibration belongs in the data directory.
calibration/cam2_calibration.yaml
calibration/camera1_recalibrated.yaml

# OS
.DS_Store
Thumbs.db

# Tooling
.claude/
